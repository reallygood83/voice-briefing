{
  "name": "obsidian-voice-briefing",
  "version": "0.3.6",
  "description": "Obsidian plugin for creating voice briefings from notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "voice",
    "tts",
    "ai",
    "briefing"
  ],
  "author": "reallygood83",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.18.3"
  }
}